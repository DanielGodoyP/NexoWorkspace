<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAF9">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:title="Centro de Avisos"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔵 Nuevas Notificaciones"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A73E8"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/layoutNuevas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👁️ Avisos Anteriores (Vistos)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#757575"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/layoutVistas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>