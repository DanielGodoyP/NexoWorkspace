<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivLogoSplash"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_app"
            android:scaleType="fitCenter"
            android:alpha="0"
            android:scaleX="0.5"
            android:scaleY="0.5"/>

        <TextView
            android:id="@+id/tvTituloSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NexoWorkspace"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_marginTop="24dp"
            android:alpha="0"
            android:translationY="50dp"/>

        <TextView
            android:id="@+id/tvSubtituloSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu espacio de trabajo inteligente"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.05"
            android:alpha="0"
            android:translationY="50dp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbSplash"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:indeterminateTint="#1A73E8"
        android:alpha="0"/>

</RelativeLayout>